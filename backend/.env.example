# ==============================================================================
# Spec Worker Agent - 环境变量模板文件 (.env.example)
# 使用说明：复制此文件为 .env 并填入您真实的 API Key 与配置
#   cp .env.example .env
# ==============================================================================

# ── 运行环境 ──
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── 数据库 (PostgreSQL) ──
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=app
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20
PG_POOL_TIMEOUT=30

# ── 缓存与消息队列 (Redis) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_STREAM_NAME=task_queue
REDIS_CONSUMER_GROUP=workers

# ── JWT 认证 ──
JWT_SECRET=your-32-character-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── 大模型 (LLM) 接入配置 ──
AGENT_MODE=llm
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your_siliconflow_or_openai_api_key_here
LLM_MODEL=Qwen/Qwen3-8B
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_MAX_STEPS=15
LLM_WORKSPACE_DIR=./workspace

# ── Agent Flow 熔断与动态重规划配置 ──
AGENT_FLOW_MAX_STEPS=100
AGENT_FLOW_MAX_REPLANS=3

# ── Docker 沙箱 (Sandbox) ──
SANDBOX_ENABLED=true
SANDBOX_URL=http://localhost:5050
SANDBOX_TIMEOUT=60

# ── Worker 与调度配置 ──
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL=10
WORKER_HEARTBEAT_TIMEOUT=60
WORKER_GRACEFUL_SHUTDOWN_TIMEOUT=30

# ── HITL 人工介入配置 ──
HITL_DEFAULT_TIMEOUT_HOURS=24
HITL_DEFAULT_ACTION=cancel

# ── 限流配置 ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
