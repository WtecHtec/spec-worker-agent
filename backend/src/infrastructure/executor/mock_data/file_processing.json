{
  "task_type": "file_processing",
  "description": "文件处理任务（含 HITL）",
  "steps": [
    {
      "step_index": 1,
      "type": "THINKING",
      "delay_ms": 800,
      "content": {
        "text": "用户上传了数据文件，我需要先扫描文件内容，检查数据质量，然后决定处理策略。"
      }
    },
    {
      "step_index": 2,
      "type": "TOOL_CALL",
      "delay_ms": 500,
      "content": {
        "tool_name": "file_scanner",
        "arguments": { "file": "data.csv", "check_anomalies": true },
        "idempotency_key": "scan-data-csv"
      }
    },
    {
      "step_index": 3,
      "type": "TOOL_RESULT",
      "delay_ms": 1000,
      "content": {
        "tool_name": "file_scanner",
        "output": {
          "total_rows": 5000,
          "anomaly_rows": 500,
          "anomaly_rate": "10%",
          "sample_anomalies": ["行 23: 金额为负数", "行 45: 日期格式错误"]
        },
        "duration_ms": 420
      }
    },
    {
      "step_index": 4,
      "type": "HITL_REQUEST",
      "delay_ms": 0,
      "wait_for_human": true,
      "content": {
        "question": "扫描发现 500 条（10%）异常数据，如何处理？",
        "type": "choice",
        "options": [
          { "value": "skip", "label": "跳过异常行，处理剩余 4500 条" },
          { "value": "fix", "label": "尝试自动修复异常数据" },
          { "value": "cancel", "label": "取消任务，我重新准备数据" }
        ]
      }
    },
    {
      "step_index": 5,
      "type": "THINKING",
      "delay_ms": 600,
      "content": {
        "text": "用户确认了处理策略，开始执行数据清洗和导入。"
      }
    },
    {
      "step_index": 6,
      "type": "FINAL",
      "delay_ms": 1200,
      "content": {
        "text": "## 文件处理完成\n\n- 处理行数：4,500 条\n- 跳过异常：500 条\n- 导入成功：✅\n\n数据已写入目标数据库。"
      }
    }
  ],
  "result": {
    "summary": "成功处理 4500 条数据，500 条异常已跳过。",
    "total_steps": 6
  }
}
