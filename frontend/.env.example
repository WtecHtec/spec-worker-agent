# ==============================================================================
# Spec Worker Agent - 前端环境变量配置模板 (.env.example)
# 使用说明：可复制为 .env.local 或 .env 并按需调整端口与服务地址
# ==============================================================================

# 后端 FastAPI 网关服务基础地址 (默认 8000 端口)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Go 沙箱服务地址 (默认 5050 端口)
NEXT_PUBLIC_SANDBOX_URL=http://localhost:5050

